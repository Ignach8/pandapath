{
  "expo": {
    "name": "PandaPath",
    "slug": "pandapath",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pandapath",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.pandapath.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#DDF3E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DDF3E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PandaPath usa el micrófono para evaluar tu pronunciación.",
          "speechRecognitionPermission": "PandaPath usa el reconocimiento de voz para evaluar tu pronunciación.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox", "com.google.android.as"]
        }
      ],
      "expo-audio",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
